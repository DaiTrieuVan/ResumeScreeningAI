# Application
PROJECT_NAME=Resume Screening AI
API_V1_STR=/api

# Local persistence. Relative paths are resolved from the backend directory.
DATABASE_URL=sqlite+aiosqlite:///./resume_screening.db
STORAGE_DIR=./storage/resumes

# Optional external AI. Leave blank to use deterministic local fallbacks.
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Optional semantic embedding model.
DEFAULT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DISABLE_EMBEDDING_MODEL=false

# Competition/demo mode: disables external models and crawlers deterministically.
OFFLINE_MODE=false
OFFLINE_ENGINE=deterministic-keyword-v1

# Gradual rollout switch for the recruiter workspace API.
RECRUITER_WORKSPACE_V2_ENABLED=true
